{
	"compilerOptions": {
		"target": "es2022",
		"module": "es2022",
		"moduleResolution": "bundler",
		"lib": ["es2022"],
		"types": ["node"],
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"experimentalDecorators": false,
		"useDefineForClassFields": false,
		"skipLibCheck": true,
		"esModuleInterop": true,
		"noEmit": true
	},
	"include": ["src/**/*.ts"]
}
